classDiagram
    class Pet {
        +string name
        +string species
        +int age
        +date birthday
        +float weight
        +string gender
        +string color
        +list~Food~ foods
        +eat(food) str
        +walk() str
        +make_sound() str
        +sleep() str
        +play() str
    }

    class Food {
        +string food_type
        +float serving_size
        +int quantity
        +purchase(quantity)
        +feed(pet)
    }

    class Scheduler {
        +Owner owner
        +list~Task~ tasks
        +display_list()
        +prioritize()
        +filter_tasks(pet, completed, pet_name) list~Task~
        +complete_task(task) Task
        +fit_to_time() list~Task~
        +unscheduled() list~Task~
        +find_conflicts() list~tuple~
    }

    class Task {
        +string description
        +int duration
        +date deadline
        +int priority
        +Pet pet
        +bool completed
        +string frequency
        +datetime start_time
        +datetime end_time
        +complete() Task
    }

    class Owner {
        +string name
        +int available_time
        +list~Pet~ pets
        +Scheduler schedule
        +add_pet(pet)
        +add_task(task)
        +remove_task(task)
        +tasks_for(pet) list~Task~
    }

    Owner "1" --> "many" Pet : owns
    Owner "1" --> "1" Scheduler : schedule
    Pet "1" --> "many" Food : eats
    Scheduler "1" --> "1" Owner : serves
    Scheduler "1" --> "many" Task : contains
    Task "many" --> "1" Pet : depends on
