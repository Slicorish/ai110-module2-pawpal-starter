classDiagram
    class Pet {
        +string name
        +string species
        +int age
        +date birthday
        +float weight
        +string gender
        +string color
        +list~Food~ foods
        +eat()
        +walk()
        +make_sound()
        +sleep()
        +play()
    }

    class Food {
        +string food_type
        +float serving_size
        +int quantity
        +purchase()
        +feed(pet)
    }

    class Todo_List {
        +list~Task~ tasks
        +display_list()
        +prioritize()
    }

    class Task {
        +string description
        +int duration
        +date deadline
        +int priority
        +Pet pet
        +bool completed
        +complete()
    }

    class Owner {
        +string name
        +int available_time
        +Todo_List schedule
        +list~Pet~ pets
        +add_task(task)
        +remove_task(task)
        +tasks_for(pet)
    }

    Owner "1" --> "many" Pet : owns
    Owner "1" --> "1" Todo_List : schedule
    Pet "1" --> "many" Food : eats
    Todo_List "1" --> "many" Task : contains
    Task "many" --> "1" Pet : depends on
